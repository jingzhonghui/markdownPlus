{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*.ts",
    "shared/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true
  }
}
